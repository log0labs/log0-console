# Server-side only - used by the API proxy route handler (app/api/v1/[...path]).
# Not exposed to the browser.
AUTH_API_URL=http://localhost:8086
INCIDENTS_API_URL=http://localhost:8083
# AI investigations, repositories and LLM settings (the ai-service).
AI_API_URL=http://localhost:8085

# Exposed to the browser (NEXT_PUBLIC_, inlined at build time).
# Public log ingestion endpoint shown on the Workspace settings page.
NEXT_PUBLIC_INGEST_URL=http://localhost:8080/api/v1/logs
